{
  "opencollection": "1.0.0",
  "info": {
    "name": "Beds24 API V2 Accounts API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.beds24.com/v2/accounts"
          },
          "docs": "Returns account-level information, including sub-accounts and users, that scopes every other API category. Modeled."
        }
      ]
    }
  ],
  "bundled": true
}